+/*
+ * Panel size and board power wiring come from the ADT (tools/mkadt.py).
+ * Both boards use the same GT9889/FT8716-class bus: QUPv3 SE7 at 0xa84000,
+ * SDA/SCL on TLMM 6/7 (qup11), reset 8, IRQ 9. They differ in the rails:
+ * sweet enables L11C (ldoc11, 3200 mV) and its power gate on TLMM 90, while
+ * davinci enables L6C (ldoc6, 3100 mV) and its 1.8 V gate on TLMM 5.
+ * Missing properties keep the sweet defaults, so old ADTs still boot.
+ */
+static void
+touch_config(void)
+{
+	DTEntry entry;
+	uint32_t const *u32p;
+	char const *strp;
+	unsigned int size;
+
+	st.panel_w = 1080;
+	st.panel_h = 2400;
+	st.power_gpio = 90;
+	strlcpy(st.vreg, "ldoc11", sizeof(st.vreg));
+	st.vreg_mv = 3200;
+
+	if (SecureDTFindEntry("name", "sweet-fbcon", &entry) == kSuccess) {
+		if (SecureDTGetProperty(entry, "width", (void const **)&u32p, &size) == kSuccess && size >= 4) {
+			st.panel_w = *u32p;
+		}
+		if (SecureDTGetProperty(entry, "height", (void const **)&u32p, &size) == kSuccess && size >= 4) {
+			st.panel_h = *u32p;
+		}
+	}
+	if (SecureDTFindEntry("name", "sweet-touch", &entry) != kSuccess) {
+		return;
+	}
+	if (SecureDTGetProperty(entry, "power-gpio", (void const **)&u32p, &size) == kSuccess && size >= 4) {
+		st.power_gpio = *u32p;
+	}
+	if (SecureDTGetProperty(entry, "vreg-mv", (void const **)&u32p, &size) == kSuccess && size >= 4) {
+		st.vreg_mv = *u32p;
+	}
+	if (SecureDTGetProperty(entry, "vreg-name", (void const **)&strp, &size) == kSuccess && size > 1 &&
+	    size <= sizeof(st.vreg)) {
+		memcpy(st.vreg, strp, size);
+		st.vreg[size - 1] = '\0';
+	}
+}
